# CVMatch AI — Frontend environment variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the frontend (Vite rule).
# Do NOT put secrets (API keys, Stripe secret keys, DB credentials) here.

# Base URL of the backend API (Laravel).
# Production default if unset: https://api.cvmatchai.us/api
# Local development example:   http://127.0.0.1:8000/api
#
# Primary variable:
VITE_API_BASE_URL=https://api.cvmatchai.us/api
#
# (Backward-compatible alias, still honored if VITE_API_BASE_URL is unset:)
# VITE_API_URL=https://api.cvmatchai.us/api
